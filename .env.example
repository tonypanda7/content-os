# Content OS - Environment Configuration
# Defaulting to Open Source Models (OpenAI-compatible endpoints)

# ==========================================
# 1. Hosted Open-Source Providers (Choose One)
# ==========================================

# OPTION A: DeepInfra (Best prices for Qwen 2.5 32B / 72B & Llama 3.3 70B)
LLM_BASE_URL="https://api.deepinfra.com/v1/openai"
LLM_API_KEY=""

# OPTION B: Groq (Ultra-fast inference for Llama 3.3 70B & Llama 3.1 8B)
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_API_KEY="gsk_..."

# OPTION C: Together AI
# LLM_BASE_URL="https://api.together.xyz/v1"
# LLM_API_KEY="..."

# OPTION D: Local Ollama (100% Free on your machine)
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_API_KEY="ollama"

# ==========================================
# 2. Default Open-Source Model Names
# ==========================================
RESEARCHER_MODEL="Qwen/Qwen2.5-32B-Instruct"
WRITER_MODEL="meta-llama/Llama-3.3-70B-Instruct"
CRITIC_MODEL="Qwen/Qwen2.5-32B-Instruct"
